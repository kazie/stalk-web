# Keep this same-origin in development so Vite can proxy requests to the remote backend.
VITE_API_ENDPOINT=/api/coords

# Remote backend used by the Vite dev proxy for HTTP requests.
VITE_DEV_PROXY_TARGET=https://your.page.com

# Optional: use a different remote host for WebSockets.
# VITE_DEV_WS_PROXY_TARGET=https://your.websocket.host
