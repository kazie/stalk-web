{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/stories/**/*"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["vite/client", "react", "react-dom"],
    "paths": {
      "@/*": ["./src/*"],
      "@ladle/react": ["./src/stories/ladle-react.d.ts"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.stories.tsbuildinfo"
  }
}
